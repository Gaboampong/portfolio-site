---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  current?: string;
}

const {
  title = 'Gabriel Adjei Boampong · Developer, Database Engineer & Data Analyst',
  description = 'Gabriel Adjei Boampong is a developer, database engineer, and data analyst in Accra who builds web products, the databases behind them, and the reporting that makes sense of them. Work includes KUCHILL, DigiHub, and Chale, where?',
  current = '/',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Y6F0NFR9ZR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-Y6F0NFR9ZR');
    </script>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Gabriel Adjei Boampong" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gabriel Adjei Boampong: developer, database engineer, and data analyst in Accra." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="sr-only-focusable fixed left-4 top-3 z-50 rounded-full bg-ink px-4 py-2 text-sm font-medium text-canvas">Skip to content</a>
    <SiteHeader current={current} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script is:inline>
      (() => {
        const items = document.querySelectorAll('.reveal, .triptych');
        if (!('IntersectionObserver' in window)) {
          items.forEach((item) => item.classList.add('is-visible'));
          return;
        }
        const show = (item) => {
          item.classList.add('is-visible');
          observer.unobserve(item);
        };
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) show(entry.target);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        items.forEach((item) => observer.observe(item));

        // A fast flick or an anchor jump can skip past items; reveal anything already above the fold line.
        let queued = false;
        const catchUp = () => {
          queued = false;
          items.forEach((item) => {
            if (!item.classList.contains('is-visible') && item.getBoundingClientRect().top < innerHeight) show(item);
          });
        };
        const queue = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(catchUp);
        };
        addEventListener('scroll', queue, { passive: true });
        addEventListener('hashchange', queue);
        queue();
      })();
    </script>
  </body>
</html>
