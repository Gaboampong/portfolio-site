---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Gabriel Adjei Boampong | Applications Developer & Database Engineer',
  description = 'Portfolio of Gabriel Adjei Boampong, an Applications Developer and Database Engineer who builds reliable applications, scalable data systems, and clear business intelligence reporting.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Y6F0NFR9ZR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-Y6F0NFR9ZR');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-paper text-ink antialiased">
    <slot />

    <script is:inline>
      const initCountUps = () => {
        const items = document.querySelectorAll('.countup');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const element = entry.target;
            if (element.dataset.started === 'true') return;
            element.dataset.started = 'true';

            const target = Number(element.dataset.count || '0');
            const duration = 1200;
            const startTime = performance.now();

            const step = (now) => {
              const progress = Math.min((now - startTime) / duration, 1);
              element.textContent = String(Math.floor(target * progress));
              if (progress < 1) {
                requestAnimationFrame(step);
              } else {
                element.textContent = String(target);
              }
            };

            requestAnimationFrame(step);
            observer.unobserve(element);
          });
        }, { threshold: 0.45 });

        items.forEach((item) => observer.observe(item));
      };

      const initReveals = () => {
        const items = document.querySelectorAll('.reveal');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.14 });

        items.forEach((item) => observer.observe(item));
      };

      const initCaseTabs = () => {
        const tabs = Array.from(document.querySelectorAll('.case-tab'));
        const panels = Array.from(document.querySelectorAll('.case-panel'));
        if (!tabs.length || !panels.length) return;

        const activate = (targetId) => {
          tabs.forEach((tab) => {
            const active = tab.dataset.caseTarget === targetId;
            tab.setAttribute('aria-pressed', active ? 'true' : 'false');
            tab.classList.toggle('border-blue/40', active);
            tab.classList.toggle('bg-blue/8', active);
            tab.classList.toggle('border-hairline', !active);
            tab.classList.toggle('bg-paper-alt', !active);
          });

          panels.forEach((panel) => {
            panel.classList.toggle('hidden', panel.dataset.casePanel !== targetId);
          });
        };

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => activate(tab.dataset.caseTarget));
        });
      };

      initCountUps();
      initReveals();
      initCaseTabs();
    </script>
  </body>
</html>
