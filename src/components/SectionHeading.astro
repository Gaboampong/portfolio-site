---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, lead, align = 'left' } = Astro.props;
const centered = align === 'center';
---

<div class:list={[
  'mb-10 max-w-3xl',
  centered && 'mx-auto text-center'
]}>
  <div class:list={['flex items-center gap-3', centered && 'justify-center']}>
    <span class="h-px w-8 bg-brass"></span>
    <p class="font-mono text-xs font-semibold uppercase tracking-[0.28em] text-ledger">{eyebrow}</p>
  </div>
  <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">{title}</h2>
  <p class="mt-4 text-base leading-8 text-muted">{lead}</p>
  <div class="mt-5 h-px w-full bg-hairline"></div>
</div>
