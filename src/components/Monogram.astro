---
// The mark: a G whose crossbar is a gold data bar. It inverts with the appearance.
interface Props {
  class?: string;
}

const { class: className = 'h-7 w-7' } = Astro.props;
---

<svg class={className} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <rect width="64" height="64" rx="14.5" fill="var(--color-ink)" />
  <path d="M44.63 20.62A17 17 0 1 0 49 32" fill="none" stroke="var(--color-canvas)" stroke-width="9" />
  <path d="M32 27.5h19a2.5 2.5 0 0 1 2.5 2.5v4a2.5 2.5 0 0 1-2.5 2.5H32Z" fill="var(--mark-gold)" />
</svg>
