---
import SectionHeading from './SectionHeading.astro';

const items = [
  {
    title: 'Application Development',
    description: 'Across a range of modern stacks, backed by well-structured databases.',
    icon: '<path d="M8 9L4.5 12 8 15M16 9l3.5 3-3.5 3M14 5l-4 14" stroke-linecap="round" stroke-linejoin="round" />',
  },
  {
    title: 'Database & SQL',
    description: 'SQL querying, optimization, and relational database design.',
    icon: '<ellipse cx="12" cy="5.5" rx="7" ry="2.5" /><path d="M5 5.5V12c0 1.38 3.13 2.5 7 2.5s7-1.12 7-2.5V5.5" /><path d="M5 12v6.5c0 1.38 3.13 2.5 7 2.5s7-1.12 7-2.5V12" />',
  },
  {
    title: 'Data Analytics & BI',
    description: 'Data analytics and BI reporting that turn raw data into clear insight.',
    icon: '<path d="M5 20V12M12 20V6M19 20v-9" stroke-linecap="round" /><path d="M3 20h18" stroke-linecap="round" />',
  },
  {
    title: 'Monitoring & Validation',
    description: 'Data validation and monitoring that improve reporting confidence.',
    icon: '<path d="M12 3l7 3.2v5.3c0 4.6-3 8.6-7 9.5-4-.9-7-4.9-7-9.5V6.2L12 3Z" stroke-linejoin="round" /><path d="M9 12.2l2.2 2.2L16 9.6" stroke-linecap="round" stroke-linejoin="round" />',
  },
];
---

<section class="mx-auto max-w-6xl px-5 py-10 sm:px-6 lg:px-8">
  <SectionHeading
    eyebrow="My Expertise"
    title="Where I add the most value"
    lead="Four areas that show up in almost everything I build, from internal platforms to reporting systems."
  />

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {items.map((item, index) => (
      <article
        class:list={[
          'reveal card-hover accent-bar rounded-3xl border bg-paper p-6 pl-7 shadow-sm',
          index === 0 ? 'border-blue/25' : 'border-hairline'
        ]}
      >
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-blue/8 text-ledger">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={item.icon} />
        </span>
        <h3 class="mt-4 text-base font-semibold tracking-tight text-ink">{item.title}</h3>
        <p class="mt-2 text-sm leading-6 text-muted">{item.description}</p>
      </article>
    ))}
  </div>
</section>
