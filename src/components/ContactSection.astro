---
import SectionHeading from './SectionHeading.astro';

const mailIcon = '<rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" stroke-linecap="round" stroke-linejoin="round" />';
const phoneIcon = '<path d="M6.5 3h3l1.5 4-2 2c.8 2 2.7 3.9 4.7 4.7l2-2 4 1.5v3c0 1.1-.9 2-2 2C10.6 21 3 13.4 3 5c0-1.1.9-2 2-2Z" stroke-linecap="round" stroke-linejoin="round" />';

const methods = [
  {
    label: 'Email',
    value: 'gabrieladjei0@gmail.com',
    href: 'mailto:gabrieladjei0@gmail.com',
    icon: mailIcon,
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/gabrielboampong',
    href: 'https://www.linkedin.com/in/gabrielboampong',
    image: '/asserts/linkedin.png',
  },
  {
    label: 'Phone',
    value: '+233 24 293 1397',
    href: 'tel:+233242931397',
    icon: phoneIcon,
  },
];
---

<section id="contact" class="mx-auto max-w-6xl px-5 py-10 sm:px-6 lg:px-8">
  <div class="grid gap-5 lg:grid-cols-[1fr_0.85fr]">
    <div class="reveal">
      <SectionHeading
        eyebrow="Contact"
        title="Available for data-focused roles and practical problem solving"
        lead="I am especially well suited to work involving reporting systems, SQL-heavy analysis, BI dashboards, monitoring workflows, and operational data improvement."
      />
    </div>

    <div class="reveal rounded-3xl border border-hairline bg-paper p-6 shadow-sm">
      <div class="space-y-3">
        {methods.map((method) => (
          <a
            class="card-hover flex items-center gap-4 rounded-2xl border border-hairline bg-paper-alt p-4 transition hover:border-blue/35 hover:bg-blue/5"
            href={method.href}
          >
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-blue/8 text-ledger">
              {method.image ? (
                <img src={method.image} alt="" class="h-5 w-5" />
              ) : (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={method.icon} />
              )}
            </span>
            <div class="min-w-0">
              <p class="font-mono text-xs uppercase tracking-[0.24em] text-ledger">{method.label}</p>
              <p class="mt-1 break-all text-base font-medium text-ink">{method.value}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="reveal mt-5 rounded-3xl bg-ledger p-7 shadow-sm sm:p-9">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.28em] text-brass">Let&rsquo;s build something reliable</p>
        <h3 class="mt-3 max-w-xl text-2xl font-semibold tracking-tight text-white sm:text-3xl">Have a role or project in mind? I read every message.</h3>
      </div>
      <a
        href="mailto:gabrieladjei0@gmail.com"
        class="inline-flex shrink-0 items-center gap-2 rounded-full bg-brass px-6 py-3 text-sm font-semibold text-ink transition hover:-translate-y-0.5 hover:bg-brass/90"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={mailIcon} />
        Email Me
      </a>
    </div>
  </div>
</section>
