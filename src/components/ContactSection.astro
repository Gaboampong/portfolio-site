---
import SectionHeading from './SectionHeading.astro';
---

<section id="contact" class="mx-auto max-w-6xl px-5 py-10 sm:px-6 lg:px-8">
  <div class="grid gap-5 lg:grid-cols-[1fr_0.85fr]">
    <div class="reveal">
      <SectionHeading
        eyebrow="Contact"
        title="Available for data-focused roles and practical problem solving"
        lead="I am especially well suited to work involving reporting systems, SQL-heavy analysis, BI dashboards, monitoring workflows, and operational data improvement."
      />
    </div>

    <div class="reveal rounded-3xl border border-hairline bg-paper p-6 shadow-sm">
      <div class="space-y-4">
        <a class="block rounded-2xl border border-hairline bg-paper-alt p-4 transition hover:border-blue/35 hover:bg-blue/5" href="mailto:gabrieladjei0@gmail.com">
          <p class="font-mono text-xs uppercase tracking-[0.24em] text-ledger">Email</p>
          <p class="mt-2 text-base font-medium text-ink">gabrieladjei0@gmail.com</p>
        </a>
        <a class="block rounded-2xl border border-hairline bg-paper-alt p-4 transition hover:border-blue/35 hover:bg-blue/5" href="https://www.linkedin.com/in/gabrielboampong">
          <p class="font-mono text-xs uppercase tracking-[0.24em] text-ledger">LinkedIn</p>
          <p class="mt-2 text-base font-medium text-ink">linkedin.com/in/gabrielboampong</p>
        </a>
        <a class="block rounded-2xl border border-hairline bg-paper-alt p-4 transition hover:border-blue/35 hover:bg-blue/5" href="tel:+233242931397">
          <p class="font-mono text-xs uppercase tracking-[0.24em] text-ledger">Phone</p>
          <p class="mt-2 text-base font-medium text-ink">+233 24 293 1397</p>
        </a>
      </div>
    </div>
  </div>
</section>
