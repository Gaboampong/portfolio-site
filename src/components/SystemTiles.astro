---
// Internal systems can't be screenshotted, so each one gets a schematic of how it works,
// drawn in code. The schematics are decorative; the text carries the content.
import { systems } from '../data/work';

interface Props {
  title: string;
  lead: string;
  headingLevel?: 'h2' | 'h3';
  id?: string;
}

const { title, lead, headingLevel = 'h2', id = 'systems' } = Astro.props;
const Heading = headingLevel;
const CardHeading = headingLevel === 'h2' ? 'h3' : 'h4';

const roles = [
  { label: 'Admin', y: 30, color: '#2997ff', to: [0, 1, 2] },
  { label: 'HR', y: 86, color: '#e3b341', to: [0, 1] },
  { label: 'Staff', y: 142, color: '#30d158', to: [1, 2] },
];
const modules = [
  { label: 'Records', y: 24 },
  { label: 'Comms', y: 80 },
  { label: 'Workflows', y: 136 },
];
---

<section id={id} aria-labelledby={`${id}-title`} class="tile tile-systems overflow-hidden rounded-[28px] px-4 py-14 sm:px-10 sm:py-20">
  <div class="reveal mx-auto mb-12 max-w-[720px] text-center">
    <p class="text-sm font-semibold" style="color: var(--tile-accent)">Behind closed doors</p>
    <Heading id={`${id}-title`} class="display mt-2 text-[36px] sm:text-[48px]">{title}</Heading>
    <p class="mt-4 text-[19px] leading-relaxed" style="color: var(--tile-ink-2)">{lead}</p>
  </div>

  <ul class="grid gap-3 lg:grid-cols-3">
    {systems.map((system, index) => (
      <li class="reveal system-card flex flex-col overflow-hidden rounded-[22px]">
        <div class="schematic aspect-[16/10] border-b px-5 pt-5" style="border-color: var(--tile-line)" aria-hidden="true">
          {index === 0 && (
            <svg viewBox="0 0 320 200" class="h-full w-full">
              {roles.map((role) =>
                role.to.map((target) => (
                  <path
                    d={`M100 ${role.y + 14} C160 ${role.y + 14}, 160 ${modules[target].y + 20}, 216 ${modules[target].y + 20}`}
                    fill="none"
                    stroke={role.color}
                    stroke-width="2"
                    stroke-opacity="0.85"
                    class="draw" pathLength="1"
                  />
                ))
              )}
              {roles.map((role) => (
                <g>
                  <rect x="16" y={role.y} width="84" height="28" rx="14" fill="#2c2c2e" />
                  <circle cx="32" cy={role.y + 14} r="5" fill={role.color} />
                  <text x="44" y={role.y + 18.5} font-size="12" font-weight="600" fill="#f5f5f7">{role.label}</text>
                </g>
              ))}
              {modules.map((module) => (
                <g>
                  <rect x="216" y={module.y} width="92" height="40" rx="10" fill="#2c2c2e" stroke="rgb(255 255 255 / 0.14)" />
                  <text x="228" y={module.y + 24.5} font-size="12" font-weight="600" fill="#f5f5f7">{module.label}</text>
                </g>
              ))}
            </svg>
          )}
          {index === 1 && (
            <svg viewBox="0 0 320 200" class="h-full w-full">
              <defs>
                <linearGradient id="bi-area" x1="0" x2="0" y1="0" y2="1">
                  <stop offset="0" stop-color="#2997ff" stop-opacity="0.45" />
                  <stop offset="1" stop-color="#2997ff" stop-opacity="0" />
                </linearGradient>
              </defs>
              {[16, 118, 220].map((x, i) => (
                <g>
                  <rect x={x} y="8" width="86" height="54" rx="10" fill="#2c2c2e" />
                  <rect x={x + 12} y="20" width="34" height="5" rx="2.5" fill="#6e6e73" />
                  <rect x={x + 12} y="34" width={[52, 40, 46][i]} height="14" rx="4" fill="#f5f5f7" />
                </g>
              ))}
              <circle cx="300" cy="18" r="4" fill="#30d158" />
              <path d="M16 176 L16 150 C40 146 52 128 76 132 S112 156 136 140 S176 104 200 112 S240 126 262 98 S292 84 304 80 L304 176 Z" fill="url(#bi-area)" />
              <path d="M16 150 C40 146 52 128 76 132 S112 156 136 140 S176 104 200 112 S240 126 262 98 S292 84 304 80" fill="none" stroke="#2997ff" stroke-width="2.5" stroke-linecap="round" class="draw" pathLength="1" />
              <circle cx="304" cy="80" r="5" fill="#2997ff" stroke="#1c1c1e" stroke-width="2" />
              <line x1="16" x2="304" y1="176" y2="176" stroke="rgb(255 255 255 / 0.14)" />
            </svg>
          )}
          {index === 2 && (
            <svg viewBox="0 0 320 200" class="h-full w-full">
              <path d="M98 44 C118 44, 112 92, 132 92" fill="none" stroke="#a1a1a6" stroke-width="1.5" class="draw" pathLength="1" />
              <path d="M98 140 C118 140, 112 108, 132 108" fill="none" stroke="#a1a1a6" stroke-width="1.5" class="draw" pathLength="1" />
              <path d="M214 100 L236 100" fill="none" stroke="#e3b341" stroke-width="2" stroke-dasharray="4 4" />
              <path d="M232 95 L238 100 L232 105" fill="none" stroke="#e3b341" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              {[
                { x: 16, y: 16, name: 'customers' },
                { x: 132, y: 66, name: 'orders' },
                { x: 16, y: 112, name: 'products' },
              ].map((table) => (
                <g>
                  <rect x={table.x} y={table.y} width="82" height="70" rx="9" fill="#2c2c2e" stroke="rgb(255 255 255 / 0.14)" />
                  <path d={`M${table.x} ${table.y + 9} a9 9 0 0 1 9 -9 h64 a9 9 0 0 1 9 9 v13 h-82 Z`} fill="#3a3a3c" />
                  <text x={table.x + 10} y={table.y + 15.5} font-size="10.5" font-weight="600" fill="#f5f5f7" font-family="ui-monospace, monospace">{table.name}</text>
                  {[34, 46, 58].map((dy, i) => (
                    <rect x={table.x + 10} y={table.y + dy} width={[54, 40, 48][i]} height="4" rx="2" fill="#6e6e73" />
                  ))}
                </g>
              ))}
              <rect x="244" y="40" width="64" height="120" rx="10" fill="#2c2c2e" />
              {[46, 70, 58, 86].map((h, i) => (
                <rect x={254 + i * 12} y={148 - h} width="8" height={h} rx="3" fill="#e3b341" class="grow" style={`--d: ${i}`} />
              ))}
            </svg>
          )}
        </div>
        <div class="flex flex-1 flex-col p-6 sm:p-7">
          <p class="text-sm font-semibold" style="color: var(--tile-ink-2)">{system.kind}</p>
          <CardHeading class="display mt-1.5 text-[24px]">{system.title}</CardHeading>
          <p class="mt-3 flex-1 text-[15px] leading-relaxed" style="color: var(--tile-ink-2)">{system.summary}</p>
          <p class="mt-6 text-sm">{system.stack.join(' · ')}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
