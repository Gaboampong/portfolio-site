---
import SectionHeading from './SectionHeading.astro';

const impacts = [
  {
    index: '01',
    title: 'Application Development',
    body: 'Build applications and services backed by relational databases, from a collaborative Django final-year project to feature work that turns requirements into working software.',
    tag: 'Python · Django · SQL',
  },
  {
    index: '02',
    title: 'Operational Reporting Systems',
    body: 'Built reporting workflows in Power BI and Excel that made trends easier to spot and business decisions easier to support.',
    tag: 'Power BI · Excel · Reporting',
  },
  {
    index: '03',
    title: 'Data Quality and Validation',
    body: 'Validated data across systems, detected inconsistencies, and improved confidence in downstream reporting.',
    tag: 'SQL · Validation · Accuracy',
  },
  {
    index: '04',
    title: 'Monitoring and Visibility',
    body: 'Used Grafana and systems monitoring practices to make infrastructure behavior and operational signals easier to understand.',
    tag: 'Grafana · Monitoring · Integrity',
  },
];
---

<section id="projects" class="mx-auto max-w-6xl px-5 py-10 sm:px-6 lg:px-8">
  <SectionHeading
    eyebrow="Impact"
    title="Useful work, not just portfolio filler"
    lead="The strongest signal in my experience is consistent: clearer reporting, better visibility, and better control over the quality of data in motion."
  />

  <div class="grid gap-5 md:grid-cols-2">
    {impacts.map((item) => (
      <article class="reveal card-hover rounded-3xl border border-hairline bg-paper p-6 shadow-sm">
        <span class="font-mono text-xs uppercase tracking-[0.24em] text-ledger">{item.index}</span>
        <h3 class="mt-4 text-2xl font-semibold tracking-tight text-ink">{item.title}</h3>
        <p class="mt-4 text-sm leading-7 text-muted">{item.body}</p>
        <span class="mt-5 inline-flex rounded-full border border-blue/20 bg-blue/6 px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-ledger">
          {item.tag}
        </span>
      </article>
    ))}
  </div>

  <div class="mt-5 grid gap-5 md:grid-cols-2">
    <article class="reveal rounded-3xl border border-hairline bg-paper p-6 shadow-sm">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.28em] text-ledger">Achievement</p>
      <h3 class="mt-4 text-2xl font-semibold tracking-tight text-ink">20% workflow efficiency improvement</h3>
      <p class="mt-4 text-sm leading-7 text-muted">
        Achieved by improving data collection processes and reducing project delays.
      </p>
    </article>

    <article class="reveal rounded-3xl border border-hairline bg-paper p-6 shadow-sm">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.28em] text-ledger">Certifications</p>
      <h3 class="mt-4 text-2xl font-semibold tracking-tight text-ink">Accenture and KPMG data analytics simulations</h3>
      <p class="mt-4 text-sm leading-7 text-muted">
        Completed Forage job simulations in September 2024, reinforcing practical analytics and visualization exposure.
      </p>
    </article>
  </div>
</section>
