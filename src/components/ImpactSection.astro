---
import SectionHeading from './SectionHeading.astro';

const codeIcon = '<path d="M8 9L4.5 12 8 15M16 9l3.5 3-3.5 3M14 5l-4 14" stroke-linecap="round" stroke-linejoin="round" />';
const chartIcon = '<path d="M5 20V12M12 20V6M19 20v-9" stroke-linecap="round" /><path d="M3 20h18" stroke-linecap="round" />';
const shieldIcon = '<path d="M12 3l7 3.2v5.3c0 4.6-3 8.6-7 9.5-4-.9-7-4.9-7-9.5V6.2L12 3Z" stroke-linejoin="round" /><path d="M9 12.2l2.2 2.2L16 9.6" stroke-linecap="round" stroke-linejoin="round" />';
const eyeIcon = '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" stroke-linejoin="round" /><circle cx="12" cy="12" r="3" />';
const trophyIcon = '<path d="M7 4h10v3a5 5 0 0 1-10 0V4Z" stroke-linejoin="round" /><path d="M7 5H4a3 3 0 0 0 3 4M17 5h3a3 3 0 0 1-3 4" stroke-linecap="round" /><path d="M12 12v3M9 20h6M9.5 17h5v3h-5v-3Z" stroke-linecap="round" stroke-linejoin="round" />';
const certIcon = '<circle cx="12" cy="8" r="5" /><path d="M9 12.5L7 21l5-3 5 3-2-8.5" stroke-linecap="round" stroke-linejoin="round" />';

const impacts = [
  {
    title: 'Application Development',
    body: 'Build applications and services backed by relational databases, from a collaborative Django final-year project to feature work that turns requirements into working software.',
    tag: 'Python · Django · SQL',
    icon: codeIcon,
  },
  {
    title: 'Operational Reporting Systems',
    body: 'Built reporting workflows in Power BI and Excel that made trends easier to spot and business decisions easier to support.',
    tag: 'Power BI · Excel · Reporting',
    icon: chartIcon,
  },
  {
    title: 'Data Quality and Validation',
    body: 'Validated data across systems, detected inconsistencies, and improved confidence in downstream reporting.',
    tag: 'SQL · Validation · Accuracy',
    icon: shieldIcon,
  },
  {
    title: 'Monitoring and Visibility',
    body: 'Used Grafana and systems monitoring practices to make infrastructure behavior and operational signals easier to understand.',
    tag: 'Grafana · Monitoring · Integrity',
    icon: eyeIcon,
  },
];
---

<section id="projects" class="mx-auto max-w-6xl px-5 py-10 sm:px-6 lg:px-8">
  <SectionHeading
    eyebrow="Impact"
    title="Useful work, not just portfolio filler"
    lead="The strongest signal in my experience is consistent: clearer reporting, better visibility, and better control over the quality of data in motion."
  />

  <div class="grid gap-5 md:grid-cols-2">
    {impacts.map((item) => (
      <article class="reveal card-hover accent-bar rounded-3xl border border-hairline bg-paper p-6 pl-7 shadow-sm">
        <span class="grid h-11 w-11 place-items-center rounded-2xl bg-blue/8 text-ledger">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={item.icon} />
        </span>
        <h3 class="mt-4 text-2xl font-semibold tracking-tight text-ink">{item.title}</h3>
        <p class="mt-4 text-sm leading-7 text-muted">{item.body}</p>
        <span class="mt-5 inline-flex rounded-full border border-blue/20 bg-blue/6 px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-ledger">
          {item.tag}
        </span>
      </article>
    ))}
  </div>

  <div class="mt-5 grid gap-5 md:grid-cols-2">
    <article class="reveal card-hover accent-bar rounded-3xl border border-hairline bg-paper p-6 pl-7 shadow-sm">
      <span class="grid h-11 w-11 place-items-center rounded-2xl bg-brass/10 text-brass">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={trophyIcon} />
      </span>
      <p class="mt-4 font-mono text-xs font-semibold uppercase tracking-[0.28em] text-ledger">Achievement</p>
      <h3 class="mt-2 text-2xl font-semibold tracking-tight text-ink">20% workflow efficiency improvement</h3>
      <p class="mt-4 text-sm leading-7 text-muted">
        Achieved by improving data collection processes and reducing project delays.
      </p>
    </article>

    <article class="reveal card-hover accent-bar rounded-3xl border border-hairline bg-paper p-6 pl-7 shadow-sm">
      <span class="grid h-11 w-11 place-items-center rounded-2xl bg-brass/10 text-brass">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={certIcon} />
      </span>
      <p class="mt-4 font-mono text-xs font-semibold uppercase tracking-[0.28em] text-ledger">Certifications</p>
      <h3 class="mt-2 text-2xl font-semibold tracking-tight text-ink">Accenture and KPMG data analytics simulations</h3>
      <p class="mt-4 text-sm leading-7 text-muted">
        Completed Forage job simulations in September 2024, reinforcing practical analytics and visualization exposure.
      </p>
    </article>
  </div>
</section>
