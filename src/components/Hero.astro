---
const proofPoints = [
  {
    label: 'Current role',
    value: 'Applications Developer & Database Engineer at DS7 Limited',
  },
  {
    label: 'Education',
    value: 'MSc Big Data Analytics, University of Ghana',
  },
  {
    label: 'Core focus',
    value: 'Application development, SQL databases, and BI reporting',
  },
];
---

<section id="top" class="relative overflow-hidden">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-8 pt-14 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:gap-10 lg:px-8 lg:pt-20">
    <div class="reveal rounded-3xl border border-hairline bg-paper p-7 shadow-sm xl:p-9">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.28em] text-ledger">Applications Developer &amp; Database Engineer</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-ink sm:text-5xl lg:text-6xl">
        Gabriel <span class="text-brass">Adjei Boampong</span>
      </h1>
      <p class="mt-4 max-w-2xl text-lg font-medium text-ink/85">
        I build dependable applications and reliable data systems, software that works and numbers teams can trust.
      </p>
      <p class="mt-5 max-w-2xl text-base leading-8 text-muted">
        Based in Accra, Ghana, I work across application development, database engineering, BI reporting, and data validation.
        My focus is simple: ship software that solves real problems, keep data dependable, and give stakeholders better visibility.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/asserts/Gabriel_Adjei_Boampong_CV.pdf"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center justify-center rounded-full bg-blue px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-ledger"
        >
          Download CV
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-full border border-hairline bg-paper px-5 py-3 text-sm font-semibold text-ink transition hover:border-blue/40 hover:bg-blue/5"
        >
          Contact Me
        </a>
      </div>

      <div class="mt-6 flex flex-wrap gap-3 text-sm">
        <a class="rounded-full border border-hairline bg-paper-alt px-4 py-2 text-slate-600 transition hover:border-blue/40 hover:text-ledger" href="https://www.linkedin.com/in/gabrielboampong">LinkedIn</a>
        <a class="rounded-full border border-hairline bg-paper-alt px-4 py-2 text-slate-600 transition hover:border-blue/40 hover:text-ledger" href="https://github.com/Gaboampong">GitHub</a>
        <span class="rounded-full border border-brass/30 bg-brass/8 px-4 py-2 text-brass">Accra, Ghana</span>
      </div>

      <div class="mt-7 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        {proofPoints.map((point) => (
          <div class="card-hover rounded-xl border border-hairline bg-paper-alt px-4 py-3.5">
            <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-ledger">{point.label}</p>
            <p class="mt-1.5 text-sm font-medium leading-6 text-ink/85">{point.value}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="reveal relative mx-auto w-full max-w-sm lg:max-w-none">
      <div class="blob absolute -right-6 -top-8 h-56 w-56 bg-blue/12 sm:h-72 sm:w-72" aria-hidden="true"></div>
      <div class="blob absolute -bottom-6 -left-6 h-28 w-28 bg-brass/12" aria-hidden="true"></div>
      <span class="absolute -left-3 top-12 h-2.5 w-2.5 rounded-full bg-brass" aria-hidden="true"></span>
      <span class="absolute -right-2 bottom-20 h-2 w-2 rounded-full bg-blue" aria-hidden="true"></span>

      <div class="relative overflow-hidden rounded-[2.5rem] border border-hairline bg-paper shadow-sm">
        <img
          src="/asserts/myPic.JPG.jpeg"
          alt="Portrait of Gabriel Adjei Boampong"
          class="h-[380px] w-full object-cover object-top sm:h-[440px]"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
