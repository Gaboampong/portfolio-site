---
import Monogram from './Monogram.astro';

interface Props {
  current?: string;
}

const { current = '/' } = Astro.props;

const links = [
  { href: '/work', label: 'Work' },
  { href: '/experience', label: 'Experience' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="nav-material sticky top-0 z-40 border-b border-line/60">
  <div class="mx-auto flex h-14 max-w-[1200px] items-center justify-between px-4 sm:px-6">
    <a href="/" class="-ml-2 inline-flex min-h-11 items-center gap-2.5 rounded-lg px-2 text-ink" aria-label="Gabriel Adjei Boampong, home">
      <Monogram class="h-7 w-7" />
      <span class="hidden text-[15px] font-semibold tracking-tight sm:inline">Gabriel Adjei Boampong</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={current === link.href ? 'page' : undefined}
          class:list={[
            'inline-flex min-h-11 items-center rounded-full px-4 text-sm transition-colors',
            current === link.href ? 'font-semibold text-ink' : 'text-ink-2 hover:text-ink',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/asserts/Gabriel_Adjei_Boampong_CV.pdf"
        class="ml-3 inline-flex min-h-9 items-center rounded-full bg-ink px-4 text-sm font-medium text-canvas transition-opacity hover:opacity-85"
      >
        Download CV
      </a>
    </nav>

    <button
      type="button"
      id="menu-button"
      class="-mr-2 inline-flex h-11 w-11 items-center justify-center rounded-full text-ink md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menu"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <path data-open d="M4 8h16M4 16h16" />
        <path data-close class="hidden" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Main" class="hidden border-t border-line/60 px-4 pb-6 pt-2 md:hidden">
    <ul>
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={current === link.href ? 'page' : undefined}
            class:list={[
              'flex min-h-12 items-center border-b border-line/60 text-[22px] tracking-tight',
              current === link.href ? 'font-semibold text-ink' : 'text-ink',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <a
      href="/asserts/Gabriel_Adjei_Boampong_CV.pdf"
      class="mt-6 inline-flex min-h-11 items-center rounded-full bg-ink px-5 text-[15px] font-medium text-canvas"
    >
      Download CV
    </a>
  </nav>
</header>

<script>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');

  if (button && menu) {
    const iconOpen = button.querySelector('[data-open]');
    const iconClose = button.querySelector('[data-close]');

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      button.setAttribute('aria-expanded', String(open));
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
    };

    button.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        setOpen(false);
        button.focus();
      }
    });
  }
</script>
