---
const links = [
  { href: '/work', label: 'Work' },
  { href: '/experience', label: 'Experience' },
  { href: '/contact', label: 'Contact' },
  { href: 'https://www.linkedin.com/in/gabrielboampong', label: 'LinkedIn' },
  { href: 'https://github.com/Gaboampong', label: 'GitHub' },
];
---

<footer class="bg-canvas-alt text-ink-2">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-4 px-4 py-8 text-xs sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>&copy; 2026 Gabriel Adjei Boampong. Built in Accra.</p>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        {links.map((link) => (
          <li><a href={link.href} class="inline-flex min-h-8 items-center hover:text-ink hover:underline">{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
