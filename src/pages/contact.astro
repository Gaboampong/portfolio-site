---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout
  title="Contact | Gabriel Adjei Boampong"
  description="Get in touch with Gabriel Adjei Boampong for data-focused roles and practical problem solving."
>
  <SiteHeader current="/contact" />

  <main class="relative overflow-hidden">
    <div class="blob pointer-events-none absolute -right-16 -top-16 h-64 w-64 bg-brass/6" aria-hidden="true"></div>
    <ContactSection />
  </main>

  <SiteFooter />
</Layout>
