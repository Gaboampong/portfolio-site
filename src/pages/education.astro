---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import EducationSection from '../components/EducationSection.astro';
---

<Layout
  title="Education | Gabriel Adjei Boampong"
  description="Academic background of Gabriel Adjei Boampong: MSc Big Data Analytics at the University of Ghana and BSc Computer Science at KNUST."
>
  <SiteHeader current="/education" />

  <main class="relative overflow-hidden">
    <div class="blob pointer-events-none absolute -right-16 -top-16 h-64 w-64 bg-blue/6" aria-hidden="true"></div>
    <EducationSection />
  </main>

  <SiteFooter />
</Layout>
