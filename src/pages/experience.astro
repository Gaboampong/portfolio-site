---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
---

<Layout
  title="Experience | Gabriel Adjei Boampong"
  description="Career history and skills of Gabriel Adjei Boampong across application development, database engineering, and BI reporting."
>
  <SiteHeader current="/experience" />

  <main class="relative overflow-hidden">
    <div class="blob pointer-events-none absolute -right-16 -top-16 h-64 w-64 bg-brass/6" aria-hidden="true"></div>
    <ExperienceSection />
  </main>

  <SiteFooter />
</Layout>
