---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FeaturedWorkSection from '../components/FeaturedWorkSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ImpactSection from '../components/ImpactSection.astro';
---

<Layout
  title="Projects | Gabriel Adjei Boampong"
  description="Case studies, disclosed projects, and measurable impact from Gabriel Adjei Boampong's application development and data engineering work."
>
  <SiteHeader current="/projects" />

  <main class="relative overflow-hidden">
    <div class="blob pointer-events-none absolute -right-16 -top-16 h-64 w-64 bg-blue/6" aria-hidden="true"></div>
    <FeaturedWorkSection />
    <ProjectsSection />
    <ImpactSection />
  </main>

  <SiteFooter />
</Layout>
